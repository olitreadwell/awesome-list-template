#!/usr/bin/env bash
# Conventional Commits, checked without a Node install.
set -euo pipefail
message_file="$1"
first_line="$(head -n 1 "$message_file")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if [[ ! "$first_line" =~ $pattern ]]; then
  echo "commit-msg: first line must match Conventional Commits, for example:" >&2
  echo "  feat: add the weekly link job" >&2
  echo "got: $first_line" >&2
  exit 1
fi
